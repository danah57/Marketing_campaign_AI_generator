# Anthropic Claude (default: Haiku for fast structured JSON)
# Must be an Anthropic key (starts with sk-ant-). Do NOT paste Google/OpenAI keys here.
ANTHROPIC_API_KEY=your_key_here
ANTHROPIC_MODEL=claude-haiku-4-5
ANTHROPIC_MAX_TOKENS=4096
ANTHROPIC_TIMEOUT_SECONDS=90
PIPELINE_TIMEOUT_SECONDS=180
STAGE_TIMEOUT_SECONDS=120

# Real LLM when a valid ANTHROPIC_API_KEY is set. If the key is missing or a placeholder,
# all Claude stages automatically use mock output (no API calls).
# Force mock even with a key: USE_MOCK_LLM=true
USE_MOCK_LLM=false

# Verbose prompts + full raw responses (campaign_model.llm logger)
DEBUG_LLM=false

# App
ALLOWED_ORIGINS=

# ML inference (Stage 7 real path). First load can take ~30s.
ML_ROOT_PATH=D:\SocialMedia Marketing\AI\campaign_model\ml
# Skip ML scoring (faster local dev): SKIP_ML_EVALUATION=true

# Influencer DB (Stage 7b). Set INFLUENCER_USE_DB=false to skip Postgres.
INFLUENCER_USE_DB=true
DB_CONNECT_TIMEOUT_SECONDS=3
